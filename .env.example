# ─────────────────────────────────────────────────────────────────────
# eComProtect frontend (Vite) — environment variables
# Copy to `.env` and fill in real values. Only VITE_* vars are exposed to the browser.
# ─────────────────────────────────────────────────────────────────────

# Backend API origin for normal data requests (axios baseURL = <this>/api).
VITE_BACKEND_URL=https://api.ecomprotect.co.uk

# Backend origin used to start Shopify OAuth (ShopifyInstall.tsx -> /shopify/install).
# Usually the same as VITE_BACKEND_URL.
VITE_API_URL=https://api.ecomprotect.co.uk

# Shopify app Client ID — public, safe to expose. Used by App Bridge as `apiKey`.
VITE_SHOPIFY_API_KEY=

# Optional: "development" | "production"
VITE_NODE_ENV=production
